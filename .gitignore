# Virtual environments
.venv

# Generated example figures. Every one of them redraws from a checkpoint
# (show_run, plot_losses, plot_extremes), so none is worth versioning.
pgd_convergence.png
pgd_vs_analytical.png
*.png
!docs/**/figures/*.png

# Trained models. Regenerate with
#   .venv/bin/python docs/examples/<case>/<FORMAT>/<script>.py <strategy> --retrain
# One file per strategy, plus one per sweep config id (.../sweep.py).
#
# The sweep_results.jsonl ledgers are deliberately NOT ignored -- they are the
# experiment record, and the only source of truth for results.
*.pt
!docs/examples/**/reference/reference_solution.pt
